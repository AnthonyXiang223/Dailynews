# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://dailynews:dailynews@localhost:5433/dailynews

# ===== LLM(必填:填你自己的 key) =====
# anthropic | openai_compatible;DeepSeek 的 Anthropic 兼容端点用 anthropic
# key 在 platform.deepseek.com 申请;也可切任意 OpenAI 兼容服务
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash[1m]
LLM_API_KEY=

# ===== 可选:向量嵌入(骨架期可不配;DeepSeek 无 embedding 接口,可填 OpenAI 或其他兼容服务) =====
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# ===== 邮件推送(SMTP;SMTP_PASSWORD 留空则降级为控制台打印) =====
# QQ 邮箱示例:授权码在 邮箱设置→账户→开启 SMTP 服务 后生成(不是邮箱登录密码)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=
SMTP_FROM=your_email@qq.com

# ===== 内容源与调度 =====
# 候选文章时间窗口(小时)
NEWS_WINDOW_HOURS=24
# RSS 源,逗号分隔;留空则仅用内置样例数据(离线演示)
# 已验证可用(2026-09):IT之家 / 量子位 / 爱范儿 / 少数派 / InfoQ / 开源中国 / 掘金
NEWS_SOURCES=https://www.ithome.com/rss/,https://www.qbitai.com/feed,https://www.ifanr.com/feed,https://sspai.com/feed,https://www.infoq.cn/feed,https://www.oschina.net/news/rss,https://juejin.cn/rss
# 定时调度开关(false 时只保留手动触发接口)
SCHEDULER_ENABLED=true
# Agent 状态落 Postgres 检查点(需要 checkpointer 扩展,骨架期默认关)
AGENT_CHECKPOINT=false
